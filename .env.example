# ==========================================
# Django Configuration
# ==========================================

# Environment: development, staging, or production
ENVIRONMENT=development

# Django security settings
# Replace with a securely generated key for your environment
SECRET_KEY='the-generated-key-here'
DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1


# ==========================================
# PostgreSQL Configuration
# Used in staging and production
# ==========================================

POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=replace-with-a-secure-password

# Docker Compose service name; use localhost for a local database
POSTGRES_HOST=db
POSTGRES_PORT=5432


# ==========================================
# Email Configuration
# ==========================================

# Django email backend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Local smtp4dev service
EMAIL_HOST=smtp4dev
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False

# smtp4dev does not require authentication by default
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Staging/production example (real SMTP provider):
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your-user
# EMAIL_HOST_PASSWORD=replace-with-a-secure-password

# Default sender address
DEFAULT_FROM_EMAIL=noreply@example.com

# ==========================================
# Celery Configuration
# ==========================================

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ==========================================
# Testing
# Only the test settings read this; CI sets it to True
# ==========================================

USE_POSTGRES_FOR_TESTS=False